# Puerto del Gateway. Evita usar el mismo que algún microservicio local.
PORT=8080

# Completar con las direcciones HTTP(S) reales cuando se conecten los micros.
# Se permiten vacías mientras se prepara el proyecto base.
USUARIOS_AUTH_URL=
MATERIAS_TUTORES_URL=
AGENDAMIENTO_SESIONES_URL=
REPORTES_MODERACION_URL=

# Origen previsto de la web. Sergio conectará esta variable con CORS.
CORS_ORIGIN=http://localhost:5173
