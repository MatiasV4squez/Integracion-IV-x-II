# Puerto del Gateway. Evita usar el mismo que algún microservicio local.
PORT=8080

# Completar con las direcciones HTTP(S) reales cuando se conecten los micros.
# Las peticiones a un servicio sin configurar devuelven 503.
USUARIOS_AUTH_URL=
MATERIAS_TUTORES_URL=
AGENDAMIENTO_SESIONES_URL=
REPORTES_MODERACION_URL=

# Origen de la web, sin ruta ni barra final. Usar * permite cualquier origen.
CORS_ORIGIN=http://localhost:5173

# Límite total de cada petición al microservicio, en milisegundos.
HTTP_TIMEOUT_MS=10000
