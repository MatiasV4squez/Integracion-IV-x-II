generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reporte {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  estado      String   @default("PENDIENTE")
  creadoEn    DateTime @default(now())
}