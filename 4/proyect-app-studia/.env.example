# Copia este archivo a .env.local (ignorado por git) y reinicia `npx expo start`.
#
# Raíz del API Gateway, incluyendo /api. Sin esta variable la app usa los datos demo de src/mocks.
#   - Navegador (expo web) en el mismo PC: http://localhost:8080/api
#   - Teléfono con Expo Go / emulador: usa la IP de tu PC en la red local, p. ej. http://192.168.1.10:8080/api
#     (emulador Android: http://10.0.2.2:8080/api)
EXPO_PUBLIC_API_URL=http://localhost:8080/api
