NODE_ENV=development
PORT=3000

# Base exclusiva de este microservicio.
DATABASE_URL=postgresql://admin_usuarios:CAMBIAR_PASSWORD@localhost:5432/usuarios_auth_db?schema=public

# Usa un valor aleatorio distinto por ambiente y no lo subas al repositorio.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=1800
JWT_IDLE_TIMEOUT_SECONDS=1800

# Servidor SMTP utilizado exclusivamente para verificar correos.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR_USUARIO_SMTP
SMTP_PASSWORD=CAMBIAR_PASSWORD_SMTP
SMTP_FROM=STP <no-reply@example.com>

# Pantalla del cliente que recibirá el token y confirmará la verificación.
EMAIL_VERIFICATION_URL=http://localhost:3001/verificar-correo
EMAIL_VERIFICATION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
EMAIL_VERIFICATION_TTL_MINUTES=30
