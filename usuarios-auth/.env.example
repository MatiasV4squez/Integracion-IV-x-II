NODE_ENV=development
PORT=3000

# Base exclusiva de este microservicio.
DATABASE_URL=postgresql://admin_usuarios:CAMBIAR_PASSWORD@localhost:5432/usuarios_auth_db?schema=public

# Usa un valor aleatorio distinto por ambiente y no lo subas al repositorio.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
JWT_ACCESS_TTL_SECONDS=1800
