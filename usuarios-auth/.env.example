NODE_ENV=development
PORT=3000

# Tu base de datos local (con tus credenciales de PostgreSQL)
DATABASE_URL="postgresql://admin_usuarios:root123@localhost:5432/usuarios_auth_db?schema=public"

# Secretos de más de 32 caracteres (listos para pasar el estricto filtro)
JWT_SECRET="esta_es_una_clave_super_secreta_y_muy_larga_para_cumplir_los_32_bytes_minimos_12345"
JWT_ACCESS_TTL_SECONDS=1800
JWT_IDLE_TIMEOUT_SECONDS=1800
INTERNAL_SERVICE_API_KEY="clave_interna_compartida_de_al_menos_32_bytes_12345"

# Configuración falsa de SMTP solo para que el servidor pase la validación y pueda arrancar
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_falso
SMTP_PASSWORD=password_falso
SMTP_FROM=STP <no-reply@example.com>

# Verificación de correos
EMAIL_VERIFICATION_URL=http://localhost:3001/verificar-correo
EMAIL_VERIFICATION_SECRET="esta_es_OTRA_clave_super_secreta_para_verificar_los_correos_123456789"
EMAIL_VERIFICATION_TTL_MINUTES=30
