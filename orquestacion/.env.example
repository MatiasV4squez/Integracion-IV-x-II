# Copia este archivo como .env (junto a docker-compose.yml) y cambia los secretos si vas a compartir el entorno.

# Puertos publicados en tu PC
GATEWAY_PORT=8080
WEB_PORT=8081
MAILPIT_PORT=8025

# URL del API Gateway que usará la app web desde el navegador (queda fija al construir la imagen).
# Para usarla desde otro dispositivo de la red, pon la IP de tu PC: http://192.168.1.10:8080/api
APP_API_URL=http://localhost:8080/api

# Base de datos (una sola instancia de PostgreSQL con 4 bases)
POSTGRES_PASSWORD=postgres

# Secretos compartidos entre micros (al menos 32 caracteres cada uno)
JWT_SECRET=cambia_este_jwt_secreto_de_al_menos_32_bytes_123456
INTEGRACION_SECRET=cambia_este_secreto_de_integracion_32_bytes_1234
INTERNAL_SERVICE_API_KEY=cambia_esta_clave_interna_de_al_menos_32_bytes_12
MODERACION_INTEGRACION_SECRET=cambia_este_secreto_de_moderacion_32_bytes_123
EMAIL_VERIFICATION_SECRET=cambia_este_secreto_de_verificacion_32_bytes_12345

# Rama de cada micro en GitHub (por defecto, las ramas del equipo)
REPO_URL=https://github.com/MatiasV4squez/Integracion-IV-x-II.git
BRANCH_USUARIOS=feature/micro_usuarios_auth
BRANCH_MATERIAS=feature/micro_materias_tutores
BRANCH_SESIONES=feature/agendamiento_sesiones
BRANCH_REPORTES=feature/micro_reportes_y_moderacion
BRANCH_GATEWAY=apigateway
