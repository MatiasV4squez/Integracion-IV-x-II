PORT=3000
# Completa la URL con tus credenciales locales. Codifica caracteres especiales.
# Formato: postgresql://USUARIO:CONTRASENA@localhost:5432/materias
DATABASE_URL=

# Mismo secreto HS256 que usuarios-auth en este ambiente; mínimo 32 bytes.
JWT_SECRET=

# Secreto compartido con los microservicios que envían estados y calificaciones.
# INTEGRACION_SECRET=secreto_compartido_de_al_menos_32_bytes
# Endpoint idempotente de usuarios-auth que asigna TUTOR a un usuario.
# USUARIOS_AUTH_ASIGNAR_TUTOR_URL=<endpoint acordado con usuarios-auth>
# Directorio persistente y privado para certificados. Requiere respaldo.
CERTIFICADOS_DIR=./certificados
