generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Materia {
  idMateria BigInt @id @default(autoincrement()) @map("id_materia")
  codigo    String @unique @db.VarChar(50)
  nombre    String @db.VarChar(150)

  @@map("materia")
}