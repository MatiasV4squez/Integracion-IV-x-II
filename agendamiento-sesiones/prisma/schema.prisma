generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Referencias externas: sin relaciones hacia tablas de otros microservicios.
model sesion {
  id_sesion           BigInt                    @id @default(autoincrement())
  id_tutee            BigInt
  id_tutor            BigInt
  id_materia          BigInt
  id_bloque           BigInt
  estado_sesion       sesion_estado_sesion_enum @default(PENDIENTE)
  inicio              DateTime                  @db.Timestamptz(3)
  fin                 DateTime                  @db.Timestamptz(3)
  fecha_creacion      DateTime                  @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime                  @default(now()) @updatedAt @db.Timestamp(6)

  @@index([id_tutee, estado_sesion])
  @@index([id_tutor, inicio, fin])
  @@index([estado_sesion, fecha_creacion])
}

enum sesion_estado_sesion_enum {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  EXPIRADA
  CANCELADA
  PENDIENTE_CIERRE
  COMPLETADA
  NO_REALIZADA
  INASISTENCIA
  EN_CONFLICTO
}
