generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reporte {
  id                  Int       @id @default(autoincrement())
  titulo              String
  descripcion         String
  estado              String    @default("PENDIENTE")
  idSesion            BigInt
  usuarioReportadorId BigInt
  usuarioReportadoId  BigInt
  motivo              String?
  resueltoPorId       BigInt?
  resueltoEn          DateTime?
  reactivadoPorId     BigInt?
  reactivadoEn        DateTime?
  creadoEn            DateTime  @default(now())
}

model AvisoSesion {
  id         Int      @id @default(autoincrement())
  origen     String
  version    Int
  idAviso    String   @unique
  fechaAviso DateTime
  tipo       String
  idSesion   BigInt
  datos      Json
  creadoEn   DateTime @default(now())

  @@index([tipo, idSesion])
  @@map("aviso_sesion")
}