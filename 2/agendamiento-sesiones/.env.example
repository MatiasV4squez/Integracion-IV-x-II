DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=agendamiento_sesiones
JWT_SECRET=
# Base HTTP(S) de materias-tutores para disponibilidad, reservas y reputación.
# Sin ruta final; usar otro puerto que este micro.
# MATERIAS_TUTORES_URL=http://127.0.0.1:3001
# Mismo secreto del receptor; al menos 32 bytes.
# INTEGRACION_SECRET=

# Contrato provisional HTTP de avisos con reportes/moderación.
# REPORTES_MODERACION_URL=http://127.0.0.1:3002
# Secreto compartido con ese receptor; al menos 32 bytes.
# MODERACION_INTEGRACION_SECRET=

# Opcional: DATABASE_URL tiene prioridad sobre las variables DB_*.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/agendamiento_sesiones
